@model RegisterSpaceModel
@{
}
<link rel="stylesheet" href="~/css/CadastroEspaco.css" />
<script src="~/js/CadastroEspaco.js"></script>
<script src="~/js/CadastroEspaco.js"></script>

<body>

    <div class="container">
        <h1>Cadastro de Espaço</h1>
        <p>Preencha os dados abaixo para cadastrar seu espaço.</p>

        <form id="formCadastro">
            <label asp-for="Name">Nome:</label>
            <input asp-for="Name" />
            <label asp-for="Description"/>Descrição:</label>
            <input asp-for="Description" />
            <label asp-for="Capacity">capacidade:</label>
            <input asp-for="Capacity" />
            <label asp-for="Localization">localização:</label>
            <input asp-for="Localization" />
            <label asp-for="Type">Tipo:</label>
            <input asp-for="Type"/>
            <label asp-for="Status" />status:</label>
            <input asp-for="Status" />
        </form>

        <p id="mensagem"></p>
    </div>

    <script src="script.js"></script>

</body>
