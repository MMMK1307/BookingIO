@{
}
<link rel="stylesheet" href="~/css/CadastroEspaco.css" />
<script src="~/js/CadastroEspaco.js"></script>
<script src="~/js/CadastroEspaco.js"></script>




<body>

    <div class="container">
        <h1>Cadastro de Espaço</h1>
        <p>Preencha os dados abaixo para cadastrar seu espaço.</p>

        <form id="formCadastro">

            <label for="nome">Nome do espaço</label>
            <input type="text" id="nome" placeholder="Ex: Salão de Eventos Central" required>

            <label for="tipo">Tipo de espaço</label>
            <select id="tipo" required>
                <option value="">Selecione</option>
                <option value="sala">Sala</option>
                <option value="salao">Salão</option>
                <option value="auditorio">Auditório</option>
                <option value="quadra">Quadra</option>
                <option value="outro">Outro</option>
            </select>

            <label for="capacidade">Capacidade</label>
            <input type="number" id="capacidade" placeholder="Ex: 50" min="1" required>

            <label for="endereco">Endereço</label>
            <input type="text" id="endereco" placeholder="Rua, número, bairro" required>

            <label for="descricao">Descrição</label>
            <textarea id="descricao" rows="5"
                      placeholder="Descreva o espaço..."></textarea>

            <label for="preco">Preço por hora</label>
            <input type="number" id="preco" placeholder="R$ 1.000,00" min="0" step="0.01">

            

            

        </form>

        <p id="mensagem"></p>
    </div>

    <script src="script.js"></script>

</body>
