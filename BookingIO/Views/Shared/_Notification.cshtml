@using BookingIO.Common
@{
    string jsonMessages = "[]";
    if (TempData[Notify.MessageKey] is not null)
    {
        jsonMessages = (string)TempData[Notify.MessageKey]!;
    }
}
<style>
    @@media only screen and (min-width: 993px) {
        #toast-container {
            top: 3%;
            right: 5%;
        }
    }

    .custom-toast {
        .tbody {
            display: block;
        }
        .title {
            font-size: 1.5rem;
            font-weight: bold;
        }
    }
    .custom-toast.success {
        background: linear-gradient(#27b1bfbb, #176585bb)!important;
    }
    .custom-toast.error {
        background: linear-gradient(#FF1F57bb, #FF6378bb)!important;
    }
    .custom-toast.warning {
        background: linear-gradient(#FF7700bb, #FFFF12bb)!important;
    }
</style>
<script>
    $(document).ready(() => {
        dealNotifications();
    });

    function dealNotifications() {
        const notifications = @Html.Raw(jsonMessages);
        for (let i = 0; i < notifications.length; i++) {
            showNotification(notifications[i]);
        }
    }

    function getNotificationClass(nType) {
        const klasses = {
            0: 'success',
            1: 'warning',
            2: 'error'
        }
        return `custom-toast ${klasses[nType]}`
    }

    function showNotification(notification) {
        const messageHtml = `
        <div class="tbody">
            <div class="title">${notification.Title}</div>
            <div>
                ${notification.Body}
            </div>
        </div>
        `;
        M.toast({ html: messageHtml, classes: getNotificationClass(notification.NType), displayLength: 7000 });
    }

    function NotifySuccess(title, body = "") {
        const notification = {
            Title: title,
            Body: body,
            NType: 0,
        };
        showNotification(notification);
    }

    function NotifyWarning(title, body = "") {
        const notification = {
            Title: title,
            Body: body,
            NType: 1,
        };
        showNotification(notification);
    }

    function NotifyError(title, body = "") {
        const notification = {
            Title: title,
            Body: body,
            NType: 2,
        };
        showNotification(notification);
    }
</script>
