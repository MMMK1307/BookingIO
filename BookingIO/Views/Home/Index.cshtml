@{
    ViewData["Title"] = "BookingIO";
}

<section class="hero">
<div class="container hero-grid">
<div>
<div class="eyebrow"><span></span> Gestão inteligente de espaços</div>
<h1>Organize seus espaços.<br/><em>Simplifique</em> suas reservas.</h1>
<p class="hero-copy">
            O BookingIO centraliza a reserva e o gerenciamento de espaços,
            evitando conflitos de horários e tornando a organização simples para todos.
          </p>
<div class="hero-actions">
<a class="btn btn-primary" href="#solucao">Conhecer o BookingIO <span>→</span></a>
<a class="btn btn-secondary" href="#como-funciona">Como funciona</a>
</div>
</div>
<div class="mockup-wrap">
