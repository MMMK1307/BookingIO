@model BookingIO.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Administração";
}

<style>
    .admin-page {
        max-width: 1180px;
        margin: 0 auto 48px;
        padding: 2em 20px;
    }

    .admin-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
    }

    .admin-eyebrow {
        display: inline-block;
        margin-bottom: 8px;
        color: #176585;
        font-size: 0.76rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 800;
    }

    .admin-head h1 {
        margin: 0;
        font-size: clamp(2rem, 3vw, 2.8rem);
        color: #1d2c3f;
    }

    .admin-head p {
        margin: 8px 0 0;
        color: #667a89;
    }

    .admin-date {
        background: #edf6ff;
        border: 1px solid #dfeefb;
        color: #176585;
        font-weight: 700;
        border-radius: 999px;
        padding: 10px 18px;
        white-space: nowrap;
    }

    .admin-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(180px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .admin-kpi {
        background: #fff;
        border: 1px solid #e4edf2;
        border-radius: 18px;
        padding: 22px 20px;
        box-shadow: 0 10px 24px rgba(24, 45, 61, 0.04);
    }

    .admin-kpi-label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #637a8c;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.72rem;
        margin-bottom: 12px;
    }

    .admin-kpi-badge {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #176585, #2bb3c7);
        color: #fff;
        font-weight: 800;
    }

    .admin-kpi strong {
        display: block;
        font-size: 2rem;
        color: #1e2e3d;
        margin-bottom: 4px;
    }

    .admin-kpi small {
        color: #6d8090;
    }

    .admin-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 24px;
    }

    .admin-panel {
        background: #fff;
        border: 1px solid #e4edf2;
        border-radius: 20px;
        padding: 22px;
        box-shadow: 0 10px 20px rgba(24, 45, 61, 0.035);
    }

    .admin-panel h2 {
        margin: 0;
        font-size: 1.45rem;
        color: #1d2c3f;
    }

    .admin-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .admin-panel-label {
        display: block;
        margin-bottom: 8px;
        color: #718aa0;
        text-transform: uppercase;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
    }

    .admin-metrics {
        display: grid;
        gap: 14px;
    }

    .admin-stat-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 0;
        border-bottom: 1px solid #edf2f6;
    }

    .admin-stat-row:last-child {
        border-bottom: none;
    }

    .admin-stat-row span {
        color: #5b7180;
    }

    .admin-stat-row strong {
        color: #1a2d3d;
        font-size: 1.1rem;
    }

    .admin-ring {
        width: 170px;
        height: 170px;
        margin: 12px auto 16px;
        border-radius: 50%;
        position: relative;
        background: conic-gradient(#2bb3c7 0 @Model.OccupancyRate%, #edf2f7 @Model.OccupancyRate% 100%);
    }

    .admin-ring::before {
        content: "";
        position: absolute;
        inset: 18px;
        background: #fff;
        border-radius: 50%;
    }

    .admin-ring span {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1;
        font-size: 1.8rem;
        font-weight: 800;
        color: #1d2c3f;
    }

    .admin-legend {
        display: flex;
        justify-content: space-around;
        gap: 10px;
        margin-top: 10px;
        color: #51697a;
        font-weight: 600;
    }

    .dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 8px;
    }

    .dot.available { background: #2bb3c7; }
    .dot.occupied { background: #f4b95d; }

    @@media (max-width: 900px) {
        .admin-kpis {
            grid-template-columns: repeat(2, minmax(160px, 1fr));
        }

        .admin-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .admin-head {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-kpis {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-page">
    <div class="admin-head">
        <div>
            <span class="admin-eyebrow">Painel Administrativo</span>
            <h1>Visão geral</h1>
            <p>Acompanhe usuários, espaços e reservas em um único lugar.</p>
        </div>
        <div class="admin-date">@DateTime.Now.ToString("dd 'de' MMMM", new System.Globalization.CultureInfo("pt-BR"))</div>
    </div>

    <div class="admin-kpis">
        <div class="admin-kpi">
            <div class="admin-kpi-label">
                <span class="admin-kpi-badge">U</span>
                Usuários
            </div>
            <strong>@Model.TotalUsers</strong>
            <small>cadastrados</small>
        </div>

        <div class="admin-kpi">
            <div class="admin-kpi-label">
                <span class="admin-kpi-badge">E</span>
                Espaços
            </div>
            <strong>@Model.TotalSpaces</strong>
            <small>@Model.ActiveSpaces ativos</small>
        </div>

        <div class="admin-kpi">
            <div class="admin-kpi-label">
                <span class="admin-kpi-badge">R</span>
                Reservas hoje
            </div>
            <strong>@Model.ReservationsToday</strong>
            <small>@Model.UpcomingReservations futuras</small>
        </div>

        <div class="admin-kpi">
            <div class="admin-kpi-label">
                <span class="admin-kpi-badge">%</span>
                Ocupação
            </div>
            <strong>@Model.OccupancyRate%</strong>
            <small>@Model.OccupiedSpaces ocupados</small>
        </div>
    </div>

    <div class="admin-grid">
        <section class="admin-panel">
            <div class="admin-panel-head">
                <div>
                    <span class="admin-panel-label">Resumo</span>
                    <h2>Indicadores gerais</h2>
                </div>
            </div>

            <div class="admin-metrics">
                <div class="admin-stat-row">
                    <span>Total de usuários</span>
                    <strong>@Model.TotalUsers</strong>
                </div>
                <div class="admin-stat-row">
                    <span>Espaços ativos</span>
                    <strong>@Model.ActiveSpaces</strong>
                </div>
                <div class="admin-stat-row">
                    <span>Reservas de hoje</span>
                    <strong>@Model.ReservationsToday</strong>
                </div>
                <div class="admin-stat-row">
                    <span>Reservas futuras</span>
                    <strong>@Model.UpcomingReservations</strong>
                </div>
            </div>
        </section>

        <section class="admin-panel">
            <div class="admin-panel-head">
                <div>
                    <span class="admin-panel-label">Ocupação</span>
                    <h2>Disponibilidade atual</h2>
                </div>
            </div>

            <div class="admin-ring">
                <span>@Model.OccupancyRate%</span>
            </div>

            <div class="admin-legend">
                <div><span class="dot available"></span> @Model.ActiveSpaces - @Model.OccupiedSpaces ocupados</div>
                <div><span class="dot occupied"></span> @Model.ActiveSpaces - @Math.Max(0, Model.ActiveSpaces - Model.OccupiedSpaces) disponíveis</div>
            </div>
        </section>
    </div>
</div>
