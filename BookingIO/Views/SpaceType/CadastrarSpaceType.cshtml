
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cadastro</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #e9ecef;
            min-height: 100vh;
        }

        .container {
            width: 320px;
            margin: 100px auto;
            padding: 20px;
            background-color: #ffffff;
            border-radius: 10px;
            box-shadow: none;
        }

        h1 {
            margin-bottom: 8px;
            color: #222;
            font-size: 24px;
            text-align: center;
            letter-spacing: 2px;
        }

        p {
            color: #666;
            text-align: center;
            font-size: 14px;
        }

        label {
            display: block;
            margin-top: 15px;
            margin-bottom: 5px;
            font-weight: bold;
        }

        input {
            width: 100%;
            padding: 9px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
        }

        button {
            width: 100%;
            margin-top: 20px;
            padding: 10px;
            border: none;
            border-radius: 5px;
            background-color: #007bff;
            color: white;
            font-size: 15px;
            letter-spacing: 2px;
            cursor: pointer;
        }

            button:hover {
                background-color: #0056b3;
            }

        #mensagem {
            margin-top: 15px;
            text-align: center;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>Cadastro</h1>

        <p>Cadastre um novo tipo de espaço.</p>

        <form id="formCadastro" method="post">

            <label for="Name">Nome:</label>

            <input id="Name"
                   name="name"
                   type="text"
                   placeholder="Digite o nome do usuário"
                   required />

            <button type="submit">
                Cadastrar
            </button>

        </form>

        <p id="mensagem"></p>

    </div>

</body>
</html>
